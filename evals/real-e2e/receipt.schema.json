{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Pulse Real Paper Acceptance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema_version",
    "run_id",
    "run_kind",
    "final_status",
    "started_at",
    "topic",
    "domain",
    "model",
    "stages",
    "browser_status"
  ],
  "properties": {
    "receipt_schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_kind": { "enum": ["real", "simulated"] },
    "final_status": { "enum": ["passed", "environment_blocked", "acceptance_failed"] },
    "started_at": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "started_at", "duration_ms", "status", "error_code", "error_summary", "metrics"],
        "properties": {
          "name": { "enum": ["preflight", "discovery", "production", "bundle_verify", "retrieval_verify", "api_chat_verify", "receipt"] },
          "started_at": { "type": "string", "minLength": 1 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["pending", "passed", "blocked", "failed", "skipped"] },
          "error_code": { "type": ["string", "null"] },
          "error_summary": { "type": ["string", "null"], "maxLength": 240 },
          "metrics": { "type": "object" }
        }
      }
    },
    "source_id": { "type": ["string", "null"] },
    "knowledge_id": { "type": ["string", "null"] },
    "knowledge_version": { "type": ["string", "null"] },
    "evidence_level": { "type": ["string", "null"] },
    "bundle_markdown_path": { "type": ["string", "null"] },
    "content_sha256": { "type": ["string", "null"] },
    "provenance_sha256": { "type": ["string", "null"] },
    "manifest_status": { "type": ["string", "null"] },
    "claim_ids": { "type": "array", "items": { "type": "string" } },
    "source_anchor_ids": { "type": "array", "items": { "type": "string" } },
    "chunk_ids": { "type": "array", "items": { "type": "string" } },
    "citation_ids": { "type": "array", "items": { "type": "string" } },
    "answer_sha256": { "type": ["string", "null"] },
    "answer_length": { "type": ["integer", "null"], "minimum": 0 },
    "browser_status": { "enum": ["pending", "passed", "failed", "skipped"] },
    "browser_summary": { "type": ["string", "null"], "maxLength": 240 }
  }
}
