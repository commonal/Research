# Development-only defaults for the isolated ResearchRAG PostgreSQL container.
DATABASE_URL=postgresql://research_pulse:research_pulse_dev_only@localhost:5433/research_pulse

# Required only for DeepSeek-generated answers and paper production. Never put
# this value in frontend/.env or in a variable prefixed with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Ordered multimodal paper reading is opt-in until the real-paper publisher
# path is accepted.  The vision alias must pass the provider capability probe.
DEEPSEEK_READING_STRATEGY=units
DEEPSEEK_READING_VISION=false
DEEPSEEK_READING_VISION_MODEL=deepseek-v4-flash-vision-exp

# Paper production uses separate budgets: deep reading may think, while the
# evidence projection and entailment calls stay short and machine-readable.
DEEPSEEK_READING_MAX_TOKENS=20000
DEEPSEEK_READING_FALLBACK_MAX_TOKENS=8192
DEEPSEEK_MAP_MAX_TOKENS=2048
DEEPSEEK_MAP_FALLBACK_MAX_TOKENS=4096
DEEPSEEK_MAP_TIMEOUT_SECONDS=90
DEEPSEEK_READING_TIMEOUT_SECONDS=90
DEEPSEEK_PROJECTION_MAX_TOKENS=2048
DEEPSEEK_PROJECTION_TIMEOUT_SECONDS=90
DEEPSEEK_JUDGE_MAX_TOKENS=128
DEEPSEEK_JUDGE_TIMEOUT_SECONDS=90
DEEPSEEK_RUN_DEADLINE_SECONDS=420
DEEPSEEK_ANSWER_MAX_TOKENS=1200
DEEPSEEK_MAX_RETRIES=1

# The opt-in real-paper acceptance command reuses DATABASE_URL and the two
# DeepSeek settings above. It stops before model calls when any preflight fails;
# never place real values in this example file or in frontend environment files.

# Daily newest-paper feed. This MVP embeds APScheduler in one FastAPI process,
# so start uvicorn without --workers. Set false to keep manual runs only.
RESEARCH_PULSE_SCHEDULER_ENABLED=true
RESEARCH_PULSE_DAILY_TIME=08:00
RESEARCH_PULSE_TIMEZONE=Asia/Shanghai

# Optional override for the canonical Markdown vault used by the recovery CLI.
RESEARCH_PULSE_VAULT_ROOT=knowledge
